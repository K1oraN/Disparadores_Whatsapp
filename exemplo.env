# =====================================================================
# Renomeie este arquivo para .env (com o ponto) e preencha.
# Vale para os dois scripts. Nao use comentarios na mesma linha do valor.
# =====================================================================

# ---------- GERAL (os dois usam) ----------
# Mude o nome a cada campanha nova. Mesma campanha = ninguem recebe duas vezes.
CAMPANHA=promo_outubro_2026
ARQUIVO_CONTATOS=contatos.csv
BANCO=disparos.db
IMAGEM_LINK=https://seusite.com.br/imagens/promo-outubro.jpg
# Envia so entre HORA_INICIO e HORA_FIM (formato 24h). 0 = nao envia domingo.
HORA_INICIO=9
HORA_FIM=19
ENVIAR_DOMINGO=0
# Usado quando o contato nao tem nome no CSV
NOME_PADRAO=cliente
# ---------- PREPARADOR e LISTAS ----------
# Arquivo que voce exporta do seu sistema (backup do banco)
BACKUP=backup_banco.csv
# Tamanho de cada lista de transmissao (limite do WhatsApp e 256)
LISTA_TAM=256
# Prefixo no nome do contato, para achar a lista na busca do WhatsApp (ex.: L01)
LISTA_PREFIXO=L

# ---------- FILTRO DE PERIODO ----------
# Nome da coluna de data no CSV (ultimo atendimento, ultimo exame, data do cadastro...)
COLUNA_DATA=ultimo_atendimento
# So entra quem tem essa data igual ou depois desta. Formato AAAA-MM-DD.
DATA_MINIMA=2024-01-01
# Alternativa movel: deixe DATA_MINIMA vazio e coloque ANOS_RETROATIVOS=2
# (sempre os ultimos 2 anos contando de hoje). 0 = desligado.
ANOS_RETROATIVOS=0
# 1 = quem esta sem data no CSV tambem entra; 0 = fica de fora
ACEITAR_SEM_DATA=0

# Respostas que tiram a pessoa das promocoes (NAO bloqueia no WhatsApp)
PALAVRAS_SAIR=SAIR,PARAR,STOP,CANCELAR,DESCADASTRAR,PARAR PROMOCOES


# ---------- OFICIAL: WhatsApp Cloud API (disparador_oficial.py) ----------
WA_TOKEN=cole_aqui_o_token_permanente_do_system_user
WA_PHONE_NUMBER_ID=123456789012345
WA_API_VERSION=v25.0
TEMPLATE_NOME=promo_outubro
TEMPLATE_IDIOMA=pt_BR
# 1 = o template tem {{1}} no texto para o nome; 0 = nao tem variavel
TEMPLATE_USA_NOME=1

# Limite do seu portfolio no WhatsApp Manager (comeca em 250). Deixe um pouco abaixo.
LIMITE_24H=200
LOTE=20
# Segundos entre uma mensagem e outra
INTERVALO_MIN=8
INTERVALO_MAX=20
# Segundos de pausa entre lotes (240 a 420 = 4 a 7 minutos)
PAUSA_LOTE_MIN=240
PAUSA_LOTE_MAX=420
# Preco por mensagem de marketing entregue (confira no painel da Meta)
CUSTO_POR_MSG=0.3217
# Horas de espera antes de tentar de novo quem bateu no limite por pessoa (131049)
ESPERA_LIMITADO_H=48

# Webhook (entregas, falhas e pedidos de SAIR)
# Invente um texto e cole o MESMO texto no painel da Meta
WEBHOOK_VERIFY_TOKEN=invente-um-texto-secreto-aqui
# App secret: developers.facebook.com > seu app > Configuracoes > Basico
WA_APP_SECRET=
WEBHOOK_PORTA=8000
# 1 = responde confirmando a saida
CONFIRMAR_SAIDA=1
MSG_CONFIRMA_SAIDA=Pronto! Voce nao vai mais receber nossas promocoes. Seus resultados e avisos continuam chegando normalmente.


# ---------- NAO OFICIAL: WhatsApp Web (disparador_nao_oficial.py) ----------
# USE UM CHIP SO PARA ISSO. Nunca o numero dos exames.
# Pasta onde fica salva a sessao do WhatsApp Web
WEB_PERFIL=perfil_whatsapp
# {nome} = primeiro nome, {link} = IMAGEM_LINK, \n = quebra de linha
WEB_MENSAGEM=Ola, {nome}! Preparamos uma novidade para voce: {link}\n\nSe nao quiser receber promocoes, responda SAIR.
# Bem mais devagar que o oficial. Comece com 20 a 40 por dia em chip novo.
WEB_LIMITE_24H=40
WEB_LOTE=8
WEB_INTERVALO_MIN=45
WEB_INTERVALO_MAX=120
WEB_PAUSA_LOTE_MIN=900
WEB_PAUSA_LOTE_MAX=1800
